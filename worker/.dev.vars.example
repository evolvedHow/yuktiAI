# Local-only secrets for `wrangler dev`. Copy to .dev.vars (git-ignored).
# In production these are set with:  npx wrangler secret put <NAME>

# ── Secret vault (worker-env) ─────────────────────────────────────────────────
# The gateway reads provider keys from the central worker-env vault. Point it at
# a local or deployed vault and give it the bearer token. Both values come from
# ~/docker/stack/.env on this machine.
VAULT_URL=http://127.0.0.1:8787
VAULT_TOKEN=

# Vault context holding this app's secrets (KEY_GROQ, ACCESS_PASSCODE, …).
VAULT_CONTEXT=yuktiai

# ── Direct overrides (optional) ───────────────────────────────────────────────
# A plain binding of the same name takes precedence over the vault. Handy for
# offline dev without a running vault; leave unset in production.
# KEY_GROQ=
# ACCESS_PASSCODE=

# ── Optional: per-profile base URL override ───────────────────────────────────
# BASE_URL_GROQ=https://api.groq.com/openai/v1
