{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yukti-llm-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Non-secret configuration. API keys are NEVER set here — use
  // `npx wrangler secret put KEY_<PROVIDER>` instead (see README.md).
  "vars": {
    // Comma-separated origin allowlist. "*" allows any origin.
    // Replace with your GitHub Pages origin before going public, e.g.
    // "https://your-user.github.io,http://localhost:5173"
    "ALLOWED_ORIGINS": "*",

    // Profile used when the browser does not name one.
    "DEFAULT_PROVIDER": "groq",

    // Extra provider profiles beyond the built-ins in src/providers.ts.
    // JSON array of { id, label, baseUrl, defaultModel, models? }.
    // Each entry still reads its key from the KEY_<ID> secret.
    // Example:
    // "[{\"id\":\"my-vllm\",\"label\":\"Self-hosted vLLM\",\"baseUrl\":\"https://llm.example.com/v1\",\"defaultModel\":\"qwen2.5-32b\"}]"
    "EXTRA_PROVIDERS": "[]"
  },

  // Per-IP rate limit so a public gateway cannot be drained by a stranger.
  // period must be 10 or 60 (seconds).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
