{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yukti-llm-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  // global_fetch_strictly_public is required so this Worker can fetch the
  // worker-env vault on the same *.workers.dev zone (otherwise Cloudflare
  // rejects the subrequest with error 1042).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // Non-secret configuration. Provider API keys are NEVER set here — they live
  // in the central worker-env vault and are fetched at runtime (see vault.ts).
  "vars": {
    // Comma-separated origin allowlist. "*" allows any origin.
    // Replace with your GitHub Pages origin before going public, e.g.
    // "https://your-user.github.io,http://localhost:5173"
    "ALLOWED_ORIGINS": "*",

    // Base URL of the worker-env vault holding this app's secrets. Set this,
    // then store the vault bearer token with `npx wrangler secret put VAULT_TOKEN`.
    // e.g. "https://worker-env-vault.<your-subdomain>.workers.dev"
    "VAULT_URL": "https://worker-env-vault.vish-ganapathy.workers.dev",

    // Vault context this gateway reads provider keys from (KEY_<PROVIDER>, …).
    "VAULT_CONTEXT": "yuktiai",

    // Profile used when the browser does not name one.
    "DEFAULT_PROVIDER": "anthropic",

    // Extra provider profiles beyond the built-ins in src/providers.ts.
    // JSON array of { id, label, baseUrl, defaultModel, models? }.
    // Each entry still reads its key from the vault as KEY_<ID>.
    // Example:
    // "[{\"id\":\"my-vllm\",\"label\":\"Self-hosted vLLM\",\"baseUrl\":\"https://llm.example.com/v1\",\"defaultModel\":\"qwen2.5-32b\"}]"
    "EXTRA_PROVIDERS": "[]"
  }

  // Note: a `ratelimits` binding (per-IP limit) was removed here because it
  // requires the paid Workers plan — on a free plan the binding fails to
  // provision and the Worker refuses to start (HTTP 1101 on every route).
  // To re-enable, add back a "ratelimits" array and upgrade to the paid plan.
}
