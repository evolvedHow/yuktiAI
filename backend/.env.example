# YuktiAI Backend — copy to .env (never commit .env)

# ── Upstream LLM provider ─────────────────────────────────────────────────────
# Base URL of any OpenAI-compatible provider (no trailing slash)
LLM_BASE_URL=https://api.groq.com/openai

# Optional direct API key for the upstream provider. Leave blank to read the key
# from the central worker-env vault instead (recommended — the vault is the
# single source of truth for secrets).
LLM_API_KEY=

# Default model — frontend model field takes precedence when set
LLM_MODEL=groq/compound-mini

# ── Secret vault (worker-env) ─────────────────────────────────────────────────
# Used only when LLM_API_KEY above is blank. The backend fetches the key named
# LLM_API_KEY from the given context at startup. Both values live in
# ~/docker/stack/.env on this machine.
VAULT_URL=
VAULT_TOKEN=
VAULT_CONTEXT=yuktiai

# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Use "*" to allow all (default).
# Restrict to your GitHub Pages URL in production, e.g.:
#   ALLOWED_ORIGINS=https://yourname.github.io
ALLOWED_ORIGINS=*
