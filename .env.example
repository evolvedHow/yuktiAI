# Copy this file to .env.local (never commit .env.local)
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
#
# Everything here is just a *default* for the Settings dialog — users can change
# any of it at runtime, and their choices are saved to localStorage.

# ── LLM gateway (the only mode) ──────────────────────────────────────────────
# URL of the shared worker-env gateway. LLM calls are routed through it and every
# provider key stays server-side — nothing secret ends up in the browser bundle.
# e.g. https://worker-env-vault.vish-ganapathy.workers.dev
VITE_BACKEND_URL=

# Which of the gateway's provider profiles to select by default (groq, openai,
# anthropic, openrouter, together, cerebras, or one you added via the Worker's
# EXTRA_PROVIDERS var). Blank = whatever the gateway reports as its default.
VITE_GATEWAY_PROVIDER=

# Model name the gateway should use. Usually pre-filled when a provider is picked.
VITE_LLM_MODEL=groq/compound-mini

# ── Debate pacing ────────────────────────────────────────────────────────────
VITE_MAX_TOKENS=420
VITE_MAX_TURNS=14

# Pause between one agent finishing and the next LLM call starting (ms).
VITE_TURN_DELAY_MS=8000

# "false" makes every turn wait for a click instead of counting down.
VITE_AUTO_ADVANCE=true

# ── Response reveal (typewriter) ─────────────────────────────────────────────
# "false" paints tokens the instant they arrive, in bursts.
VITE_TYPEWRITER=true

# "word" (easier to read) or "char"
VITE_TYPEWRITER_MODE=word

# Reveal rate — words/sec in word mode, chars/sec in char mode.
VITE_TYPEWRITER_RATE=8

# ── Accuracy / fact-checking ─────────────────────────────────────────────────
# Inject the sourcing rules (public/agents/evidence-policy.md) into every
# speaker's prompt: no invented URLs, statistics, quotations or study names.
# Free — no extra calls.
VITE_EVIDENCE_POLICY=true

# Fetch every cited URL through the gateway to see if it resolves. Requires
# VITE_BACKEND_URL — a browser cannot check arbitrary sites (CORS).
VITE_VERIFY_LINKS=true

# Run a reviewer model over each turn to flag claims that look invented.
# Costs one extra LLM call per turn, roughly doubling usage.
VITE_REVIEW_CLAIMS=true

# How many times a rejected turn may be re-delivered before it stands as-is.
VITE_MAX_REDOS=1

# ── New topic review ─────────────────────────────────────────────────────────
# "true" sends every newly-created topic through the topic-review agent
# (public/agents/topic-reviewer.md) before it is saved — the title gets
# sharpened, search keywords are added, and a tone is suggested. The user sees
# and approves the edits. Skipped automatically when the gateway is unreachable.
VITE_REVIEW_NEW_TOPICS=true
